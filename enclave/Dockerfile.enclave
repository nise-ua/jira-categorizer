# Nitro Enclaves oriented image.
# Build on an EC2 parent with Nitro CLI, then:
#   nitro-cli build-enclave --docker-uri jira-cat:enclave --output-file jira-cat.eif
#   nitro-cli run-enclave --eif-path jira-cat.eif --cpu-count 2 --memory 4096 --enclave-cid 16
#
# Host side proxies vsock CID:5000 -> customer VPC / internal ALB.
# Decrypt DEK via KMS only after verifying attestation PCRs.

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt pyproject.toml README.md ./
COPY src ./src
COPY config ./config

RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir -e . \
    && useradd -m -u 10001 enclave \
    && mkdir -p /app/artifacts/models /app/artifacts/sealed \
    && chown -R enclave:enclave /app

USER enclave

# Models are expected to be injected sealed at boot (vsock / block device)
ENV JIRA_CAT_ENCLAVE_MODE=nitro
ENV PYTHONUNBUFFERED=1

# vsock-facing HTTP inside enclave (parent uses socat/vsock-proxy)
EXPOSE 8080
CMD ["jira-cat-serve", "--host", "127.0.0.1", "--port", "8080"]
